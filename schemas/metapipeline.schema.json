{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nf-meta metapipeline configuration",
  "$defs": {
    "NfModule": {
      "description": "A Nextflow module step executed with 'nextflow module run'.",
      "properties": {
        "type": {
          "const": "nf-module",
          "default": "nf-module",
          "title": "Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "nf_config": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nf Config"
        },
        "params": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Params"
        },
        "container_engine": {
          "anyOf": [
            {
              "enum": [
                "docker",
                "singularity",
                "conda",
                "podman"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Engine"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Step id(s) this step directly depends on (its predecessors) -- a single id, or a list of ids."
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "NfModule",
      "type": "object"
    },
    "NfPipeline": {
      "description": "A Nextflow pipeline step executed with 'nextflow run'.",
      "properties": {
        "type": {
          "const": "nf-pipeline",
          "default": "nf-pipeline",
          "title": "Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "nf_config": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nf Config"
        },
        "params": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Params"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "params_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Params File"
        },
        "nf_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nf Profile"
        },
        "main_script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Main Script"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Step id(s) this step directly depends on (its predecessors) -- a single id, or a list of ids."
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "NfPipeline",
      "type": "object"
    }
  },
  "type": "object",
  "required": [
    "config_version"
  ],
  "anyOf": [
    {
      "required": [
        "steps"
      ]
    },
    {
      "required": [
        "workflows"
      ]
    }
  ],
  "properties": {
    "config_version": {
      "type": "string"
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "nf-module": "#/$defs/NfModule",
            "nf-pipeline": "#/$defs/NfPipeline"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/NfPipeline"
          },
          {
            "$ref": "#/$defs/NfModule"
          }
        ]
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "nf-module": "#/$defs/NfModule",
            "nf-pipeline": "#/$defs/NfPipeline"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/NfPipeline"
          },
          {
            "$ref": "#/$defs/NfModule"
          }
        ]
      },
      "deprecated": true,
      "description": "Deprecated: use 'steps'."
    },
    "globals": {
      "description": "Settings applied across every workflow in a metapipeline (the config's\n`globals:` key). `params` is merged under each workflow's own `params` at\nrun time, with the workflow's own values winning on key collision;\n`nf_profile`/`nf_config` likewise act as a fallback a workflow can\noverride, not a value forced onto it.",
      "properties": {
        "nf_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nf Profile"
        },
        "nf_config": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nf Config"
        },
        "params": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Params"
        },
        "nextflow_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nextflow Version"
        }
      },
      "title": "GlobalOptions",
      "type": "object"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "additionalProperties": false,
            "description": "One entry of the config's `inputs:` section, as written.",
            "properties": {
              "bind": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ],
                "description": "Step params this input fills, as '<step_id>.<param>'."
              },
              "default": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Default"
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Description"
              },
              "type": {
                "anyOf": [
                  {
                    "enum": [
                      "string",
                      "integer",
                      "number",
                      "boolean"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Type"
              },
              "format": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Format"
              },
              "enum": {
                "anyOf": [
                  {
                    "items": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "integer"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Enum"
              },
              "pattern": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Pattern"
              },
              "minimum": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Minimum"
              },
              "maximum": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Maximum"
              },
              "exists": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Exists"
              },
              "mimetype": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Mimetype"
              },
              "schema": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Schema"
              }
            },
            "title": "InputDefinition",
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  }
}
